@PACKAGE_INIT@

# Deprecated source-compatibility package. The sonic-silver package historically
# exposed these Breeze variables; keep them mapped to the Silver implementation.
set(BREEZE_WITH_KDECORATION @WITH_DECORATIONS@)
if(BREEZE_WITH_KDECORATION)
    set(BREEZE_KDECORATION_PLUGIN_ID "org.kde.silver")
else()
    set(BREEZE_KDECORATION_PLUGIN_ID "")
endif()

set(BREEZE_STYLE_NAME "silver")
set(BREEZE_COLOR_INSTALL_ROOT "@PACKAGE_KDE_INSTALL_FULL_DATADIR@/color-schemes/")
