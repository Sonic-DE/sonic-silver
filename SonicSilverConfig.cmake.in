@PACKAGE_INIT@

set(SILVER_WITH_KDECORATION @WITH_DECORATIONS@)
if(SILVER_WITH_KDECORATION)
    set(SILVER_KDECORATION_PLUGIN_ID "org.kde.silver")
else()
    set(SILVER_KDECORATION_PLUGIN_ID "")
endif()

set(SILVER_STYLE_NAME "silver")
set(SILVER_COLOR_INSTALL_ROOT "@PACKAGE_KDE_INSTALL_FULL_DATADIR@/color-schemes/")
